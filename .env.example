# .env.example — committed template; copy to .env and fill in real values.
# .env is gitignored (.env* rule in configs/.gitignore); .env.example is not.
# Never commit secrets to version control.
#
# Full reference: docs/CONTRACT.md
# None of these are secrets — caobunga has no key vault; it queries usage
# and launches already-authenticated provider CLIs.

# --- On-disk store ---
# CAOBUNGA_HOME=                   # default: ~/.caobunga

# --- Worker selection ---
# CAOBUNGA_WORKER=                 # local (the only adapter since CBN-204), default: local
#                                  #   local → spawn a provider CLI headless in the
#                                  #           project cwd (auto-approves its own
#                                  #           tool calls)
# CAOBUNGA_RUN_TIMEOUT=            # seconds, default: 7200

# --- Status API server (backend/main.py) ---
# CAOBUNGA_API_RELOAD=             # 1/true/yes/on enables uvicorn --reload (dev only); default: off
